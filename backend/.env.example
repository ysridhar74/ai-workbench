# ──────────────────────────────────────────────
# AI Workbench Backend — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000   # Frontend origin (web dev server)

# ── MongoDB ────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai_workbench

# ── LLM ────────────────────────────────────────
# Select the LLM provider. Supported values:
#   (unset)  → OpenAI-compatible (OpenAI direct, LiteLLM proxy, Ollama, Anthropic via proxy)
#   azure    → Azure OpenAI (fill in AZURE_OPENAI_* vars below)
# LLM_PROVIDER=azure

# Model name — used for OpenAI-compatible providers (ignored when LLM_PROVIDER=azure)
# Examples:
#   claude-3-5-sonnet-20241022    (Anthropic direct)
#   gpt-4o                        (OpenAI direct)
#   anthropic/claude-3-5-sonnet   (via LiteLLM proxy)
LLM_MODEL=claude-3-5-sonnet-20241022

# API key for your LLM provider (only one needed depending on your model)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: LiteLLM proxy base URL
# If set, all LLM calls route through the proxy instead of calling the provider directly
# LLM_BASE_URL=http://localhost:4000

# ── Azure OpenAI (set LLM_PROVIDER=azure to activate) ──────────
# Find these in Azure Portal → your OpenAI resource → Keys and Endpoint
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_OPENAI_INSTANCE_NAME=my-company-openai     # resource name only, not the full URL
# AZURE_OPENAI_DEPLOYMENT=gpt-4o                   # deployment name from Azure AI Studio
# AZURE_OPENAI_API_VERSION=2024-02-01              # API version (default: 2024-02-01)

# ── Embeddings ─────────────────────────────────
# Model used to generate RAG embeddings.
# OpenAI: text-embedding-3-small (default, best value)
# Ollama: nomic-embed-text  (run: ollama pull nomic-embed-text)
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=http://localhost:11434/v1   # Uncomment to use Ollama for embeddings
# EMBEDDING_API_KEY=                             # Defaults to OPENAI_API_KEY if not set

# ── RAG ────────────────────────────────────────
# MongoDB Atlas Vector Search index name (create this in the Atlas UI — see PHASE2.md)
MONGODB_VECTOR_INDEX=rag_vector_index
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_SEED_DOCS=true   # Set to false to skip seeding sample-docs/ on startup

# ── MCP ────────────────────────────────────────
# Root directory the Filesystem MCP server is allowed to read/write
MCP_FILESYSTEM_ROOT=/tmp/ai-workbench-files

# ── Multi-database querying ─────────────────────
# Application databases are registered in config/mongo-databases.json.
# Each entry has a name, URI, and database — set enabled: true to activate.
#
# By default all entries use MONGODB_URI (same cluster, different DB names).
# For a completely separate cluster (e.g. analytics warehouse), add a new URI:
# ANALYTICS_MONGODB_URI=mongodb+srv://<user>:<password>@<other-cluster>.mongodb.net/

# ── LangSmith Observability ────────────────────
# Get your API key from https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=ai-workbench-dev
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # default, override for self-hosted
