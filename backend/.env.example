# ──────────────────────────────────────────────
# AI Workbench Backend — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000   # Frontend origin (web dev server)

# ── MongoDB ────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai_workbench

# ── LLM ────────────────────────────────────────
# Model name — any model string supported by your provider or LiteLLM proxy
# Examples:
#   claude-3-5-sonnet-20241022    (Anthropic direct)
#   gpt-4o                        (OpenAI direct)
#   anthropic/claude-3-5-sonnet   (via LiteLLM proxy)
LLM_MODEL=claude-3-5-sonnet-20241022

# API key for your LLM provider (only one needed depending on your model)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: LiteLLM proxy base URL
# If set, all LLM calls route through the proxy instead of calling the provider directly
# LLM_BASE_URL=http://localhost:4000

# ── Embeddings ─────────────────────────────────
# Model used to generate RAG embeddings.
# OpenAI: text-embedding-3-small (default, best value)
# Ollama: nomic-embed-text  (run: ollama pull nomic-embed-text)
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=http://localhost:11434/v1   # Uncomment to use Ollama for embeddings
# EMBEDDING_API_KEY=                             # Defaults to OPENAI_API_KEY if not set

# ── RAG ────────────────────────────────────────
# MongoDB Atlas Vector Search index name (create this in the Atlas UI — see PHASE2.md)
MONGODB_VECTOR_INDEX=rag_vector_index
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_SEED_DOCS=true   # Set to false to skip seeding sample-docs/ on startup

# ── MCP ────────────────────────────────────────
# Root directory the Filesystem MCP server is allowed to read/write
MCP_FILESYSTEM_ROOT=/tmp/ai-workbench-files

# ── MongoDB Query MCP Server ────────────────────
# Database containing your business data (entities, trading partners, etc.)
# Can be the same as MONGODB_DB or a different database on the same cluster
MONGODB_QUERY_DB=your_business_db

# Absolute path to the mongodb-query MCP server folder on your machine
# Example: /Users/yourname/projects/ai-workbench/mcp-servers/mongodb-query
MONGODB_QUERY_MCP_PATH=/absolute/path/to/mcp-servers/mongodb-query

# The MCP server re-uses MONGODB_URI, OPENAI_API_KEY, LLM_MODEL, LLM_BASE_URL
# from above — no additional keys needed unless you want separate credentials.

# ── LangSmith Observability ────────────────────
# Get your API key from https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=ai-workbench-dev
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # default, override for self-hosted
