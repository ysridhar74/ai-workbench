[
  {
    "name": "filesystem",
    "description": "Read and write files on the local file system",
    "enabled": true,
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "${MCP_FILESYSTEM_ROOT}"],
    "tools": [
      "read_file",
      "read_multiple_files",
      "write_file",
      "list_directory",
      "create_directory",
      "move_file",
      "search_files",
      "get_file_info"
    ]
  }
]
